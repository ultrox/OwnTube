# Production dashboard: https://ytdash.gromobran.com
# Copy to .env on the deployment host before starting Docker Compose.
COOKIE_SECURE=true

# Optional explicit language-analysis provider; leave unset for manual/saved-evidence review.
# LANGUAGE_ANALYZER_URL=https://your-analyzer.example/assess
# LANGUAGE_ANALYZER_TOKEN=

# Optional automatic Home German matching (also requires Python 3, yt-dlp and
# scripts/german-matcher.py in the runtime image; see docs/german-home-mix.md).
# DEEPSEEK_API_KEY=
# GERMAN_TRANSLATION_MODEL=deepseek-flash
